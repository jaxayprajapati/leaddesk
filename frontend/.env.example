API_URL=http://127.0.0.1:8001   # where the FastAPI backend runs
API_KEY=long-random-string      # same value as API_KEY in backend/.env
SESSION_SECRET=at-least-32-random-characters   # signs the login cookie; e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
# TZ=Asia/Kolkata                               # in production, so visit times in drafted messages use the agency's timezone
