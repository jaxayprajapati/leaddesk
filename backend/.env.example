ANTHROPIC_API_KEY=sk-ant-...        # console.anthropic.com (API billing)
API_KEY=long-random-string           # same value as API_KEY in frontend/.env.local
SECRET_KEY=at-least-32-random-characters  # encrypts connector tokens and signs connect links; never change it once agencies connect
# CLAUDE_MODEL=claude-opus-5-5       # or claude-sonnet-5-5 / claude-haiku-5-5 to cut cost per lead
# DB_PATH=leads.db

# Public addresses (set both when deployed)
# DASHBOARD_URL=https://app.leaddesk.in        # the frontend; alert links and OAuth redirects use it
# PUBLIC_API_URL=https://api.leaddesk.in       # this backend; shown to agencies for their website form

# Email alerts, visit reminders and monthly reports: one sending account for every agency
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=alerts@leaddesk.in
# SMTP_PASSWORD=app-password
# SMTP_FROM=LeadDesk <alerts@leaddesk.in>

# Gmail connector (Google Cloud OAuth client; redirect URI <DASHBOARD_URL>/connectors/callback/gmail)
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...

# Outlook connector (Azure app registration; redirect URI <DASHBOARD_URL>/connectors/callback/outlook)
# MICROSOFT_CLIENT_ID=...
# MICROSOFT_CLIENT_SECRET=...

# Facebook and Instagram connector (Meta app; redirect URI <DASHBOARD_URL>/connectors/callback/meta,
# webhook <PUBLIC_API_URL>/webhooks/meta). Also used for WhatsApp Business API calls.
# META_APP_ID=...
# META_APP_SECRET=...
# META_VERIFY_TOKEN=any-random-string          # the same value you type into the Meta webhook settings
# META_API_VERSION=v23.0

# LeadDesk email addresses: <agency>@INBOUND_DOMAIN, delivered by deploy/cloudflare-email-worker.js
# INBOUND_DOMAIN=leads.leaddesk.in
# INBOUND_SECRET=another-random-string

# Follow-ups: days after first contact when each follow-up is due (default 1,3,7).
# Currency, timezone and phone country code are set per agency (sign-up and Settings), not here.
# FOLLOW_UP_DAYS=1,3,7
